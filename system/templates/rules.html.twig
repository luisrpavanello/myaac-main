<div class="BoxContent" style="background-image:url({{ template_path }}/images/global/content/scroll.gif);">
  <div class="TableContainer">
    <div class="CaptionContainer"><div class="CaptionInnerContainer">
      <span class="CaptionEdgeLeftTop" style="background-image:url({{ template_path }}/images/global/content/box-frame-edge.gif);"></span>
      <span class="CaptionEdgeRightTop" style="background-image:url({{ template_path }}/images/global/content/box-frame-edge.gif);"></span>
      <span class="CaptionBorderTop" style="background-image:url({{ template_path }}/images/global/content/table-headline-border.gif);"></span>
      <span class="CaptionVerticalLeft" style="background-image:url({{ template_path }}/images/global/content/box-frame-vertical.gif);"></span>
      <div class="Text">{{ t('rules.title', 'Server Rules') }}</div>
      <span class="CaptionVerticalRight" style="background-image:url({{ template_path }}/images/global/content/box-frame-vertical.gif);"></span>
      <span class="CaptionBorderBottom" style="background-image:url({{ template_path }}/images/global/content/table-headline-border.gif);"></span>
      <span class="CaptionEdgeLeftBottom" style="background-image:url({{ template_path }}/images/global/content/box-frame-edge.gif);"></span>
      <span class="CaptionEdgeRightBottom" style="background-image:url({{ template_path }}/images/global/content/box-frame-edge.gif);"></span>
    </div></div>
    <table class="Table1" cellpadding="0" cellspacing="0"><tbody><tr><td><div class="InnerTableContainer"><div class="TableContentContainer"><div class="rules-content">
      <p>{{ t('rules.intro', '{server} is an online role-playing game. To keep the game welcoming and enjoyable, every player must behave respectfully and responsibly.', {'server': config['lua']['serverName']}) }}</p>
      <p>{{ t('rules.intro_2', '{server} may act against destructive behaviour in the game, on the website, or in any other service. The following list describes the most important violations.', {'server': config['lua']['serverName']}) }}</p>
      <ol class="rules-content__list">
        <li><strong>{{ t('rules.names', 'Names') }}</strong><ul>
          <li><b>{{ t('rules.offensive_name', 'Offensive name') }}</b> — {{ t('rules.offensive_name_copy', 'Names that are insulting, racist, sexually explicit, drug-related, harassing, or otherwise objectionable.') }}</li>
          <li><b>{{ t('rules.forbidden_advertising', 'Forbidden advertising') }}</b> — {{ t('rules.forbidden_advertising_copy', 'Names or statements that advertise third-party brands, services, unrelated content, or real-money trading.') }}</li>
          <li><b>{{ t('rules.unsuitable_name', 'Unsuitable name') }}</b> — {{ t('rules.unsuitable_name_copy', 'Names that express religious or political views.') }}</li>
          <li><b>{{ t('rules.rule_violation_support', 'Supporting rule violations') }}</b> — {{ t('rules.rule_violation_support_copy', 'Names or statements that support, incite, announce, or imply a violation of these rules.') }}</li>
        </ul></li>
        <li><strong>{{ t('rules.statements', 'Statements') }}</strong><ul>
          <li><b>{{ t('rules.offensive_statement', 'Offensive statement') }}</b> — {{ t('rules.offensive_statement_copy', 'Insulting, racist, sexually explicit, drug-related, harassing, or otherwise objectionable statements.') }}</li>
          <li><b>{{ t('rules.spamming', 'Spamming') }}</b> — {{ t('rules.spamming_copy', 'Excessively repeating identical or similar messages, or posting badly formatted or nonsensical text.') }}</li>
          <li><b>{{ t('rules.off_topic', 'Off-topic public statement') }}</b> — {{ t('rules.off_topic_copy', 'Public statements unrelated to the topic of the channel or board being used.') }}</li>
          <li><b>{{ t('rules.language', 'Language restriction') }}</b> — {{ t('rules.language_copy', 'Use the language required by the relevant channel or board.') }}</li>
        </ul></li>
        <li><strong>{{ t('rules.cheating', 'Cheating') }}</strong><ul>
          <li><b>{{ t('rules.bug_abuse', 'Bug abuse') }}</b> — {{ t('rules.bug_abuse_copy', 'Exploiting obvious errors in the game or in any related service.') }}</li>
          <li><b>{{ t('rules.unofficial_software', 'Unofficial software') }}</b> — {{ t('rules.unofficial_software_copy', 'Manipulating the official client or using additional software to play the game.') }}</li>
        </ul></li>
        <li><strong>{{ t('rules.impersonation', 'Impersonation and false reports') }}</strong> — {{ t('rules.impersonation_copy', 'Pretending to represent {server}, publishing knowingly false information about it, or submitting misleading reports.', {'server': config['lua']['serverName']}) }}</li>
        <li><strong>{{ t('rules.legal', 'Legal issues') }}</strong> — {{ t('rules.legal_copy', 'Hacking, attacking or disrupting services, stealing personal data, or violating applicable laws and third-party rights.') }}</li>
      </ol>
      <p><b>{{ t('rules.consequences', 'Breaking or attempting to break these rules can lead to temporary or permanent sanctions, including the removal of characters, accounts, items, or skills. Sanctions depend on the severity of the violation and the player’s history. These rules may change; updates will be announced on the official website.') }}</b></p>
    </div></div></div></td></tr></tbody></table>
  </div>
</div>
