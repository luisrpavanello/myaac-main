<h2>{{ t('lost.title', 'Account Recovery') }}</h2>

<p>{{ t('lost.intro', 'If you no longer have access to your account, this page can help you recover it. You will need to confirm that the account belongs to you.') }}</p>

<p>{{ t('lost.can', 'With account recovery, you can:') }}</p>

<ul class="CustomBulletPointList"
    style="list-style-image: url(https://static.tibia.com/images/global/content/bullet.gif);">
  <li>{{ t('lost.benefit_password', 'request a new password when you have lost the current one;') }}</li>
  <li>{{ t('lost.benefit_hacked', 'recover an account that has been compromised;') }}</li>
  <li>{{ t('lost.benefit_email', 'change the account email using a valid recovery key;') }}</li>
  <li>{{ t('lost.benefit_key', 'request a new recovery key for a registered account.') }}</li>
</ul>

<p>{{ t('lost.first_step', 'Start by entering a character name or the email address associated with the account, then choose what you need.') }}</p>

<br/>

<div class="TableContainer">
  <div class="CaptionContainer">
    <div class="CaptionInnerContainer">
      <span class="CaptionEdgeLeftTop"
            style="background-image:url({{ template_path }}/images/global/content/box-frame-edge.gif);"></span>
      <span class="CaptionEdgeRightTop"
            style="background-image:url({{ template_path }}/images/global/content/box-frame-edge.gif);"></span>
      <span class="CaptionBorderTop"
            style="background-image:url({{ template_path }}/images/global/content/table-headline-border.gif);"></span>
      <span class="CaptionVerticalLeft"
            style="background-image:url({{ template_path }}/images/global/content/box-frame-vertical.gif);"></span>
      <div class="Text">{{ t('lost.form_title', 'Account Recovery') }}</div>
      <span class="CaptionVerticalRight"
            style="background-image:url({{ template_path }}/images/global/content/box-frame-vertical.gif);"></span>
      <span class="CaptionBorderBottom"
            style="background-image:url({{ template_path }}/images/global/content/table-headline-border.gif);"></span>
      <span class="CaptionEdgeLeftBottom"
            style="background-image:url({{ template_path }}/images/global/content/box-frame-edge.gif);"></span>
      <span class="CaptionEdgeRightBottom"
            style="background-image:url({{ template_path }}/images/global/content/box-frame-edge.gif);"></span>
    </div>
  </div>
  <table class="Table3" cellpadding="0" cellspacing="0">
    <tbody>
    <tr>
      <td>
        <div class="InnerTableContainer">
          <table style="width:100%;">
            <tbody>
            <tr>
              <td>
                <div class="TableContentContainer">
                  <form action="?subtopic=lostaccount&action=step1" method=post>
                    <input type="hidden" name="character" value="">
                    <table cellspacing="1" cellpadding="4" border="0" width="100%">
                      <tr>
                        <td bgcolor="{{ config.darkborder }}"><b>{{ t('lost.character_label', 'Character name') }}</b></td>
                      </tr>
                      <tr>
                        <td bgcolor="{{ config.darkborder }}">
                          <input type="text" name="nick" size="40" autofocus/><br>
                        </td>
                      </tr>
                      <tr>
                        <td bgcolor="{{ config.darkborder }}"><b>{{ t('lost.or_email', 'Or enter your email address') }}</b></td>
                      </tr>
                      <tr>
                        <td bgcolor="{{ config.darkborder }}">
                          <input type="text" name="email_rcv" size="40" autofocus/><br>
                        </td>
                      </tr>
                    </table>
                    <table cellspacing="1" cellpadding="4" border="0" width="100%">
                      <tr>
                        <td bgcolor="{{ config.darkborder }}"><b>{{ t('lost.what_do_you_need', 'What do you need?') }}</b></td>
                      </tr>
                      <tr>
                        <td bgcolor="{{ config.darkborder }}">
                          <input type="radio" name="action_type" id="action_type_email" value="email">
                          <label for="action_type_email"> {{ t('lost.option_email', 'Send my account name and a new password to the account email.') }}</label><br/>
                          <input type=radio name="action_type" id="action_type_key" value="reckey">
                          <label for="action_type_key"> {{ t('lost.option_key', 'I have a recovery key and want to set a new password and email address.') }}</label><br/>
                          <input type="radio" name="action_type" id="action_type_no_char" value="no_char">
                          <label for="action_type_no_char"> {{ t('lost.option_no_character', 'I do not have a character and want to recover my account by email.') }}</label><br/>
                        </td>
                      </tr>
                    </table>
                    <br/>
                    <table cellspacing="0" cellpadding="0" border="0" width="100%">
                      <tr>
                        <td align="center">
                          {{ include('buttons.submit.html.twig') }}
                        </td>
                      </tr>
                    </table>
                  </form>
                </div>
              </td>
            </tr>
            </tbody>
          </table>
        </div>
      </td>
    </tr>
    </tbody>
  </table>
</div>


