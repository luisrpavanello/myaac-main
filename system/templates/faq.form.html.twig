<form method="post" action="{{ link }}">
    {% if action == 'edit' %}
        <input type="hidden" name="id" value="{{ id }}" />
    {% endif %}
	<section class="faq-editor zealot-panel" aria-labelledby="faq-editor-title">
		<h2 class="zealot-panel__title" id="faq-editor-title">{% if action == 'edit' %}Edit{% else %}Add{% endif %} FAQ</h2>
		<div class="zealot-panel__body">
			<label class="faq-editor__field">
				<span>Question</span>
				<input class="zealot-field" name="question" value="{% if question is not null %}{{ question }}{% endif %}" maxlength="255" required/>
			</label>
			<label class="faq-editor__field">
				<span>Answer</span>
				<textarea class="zealot-field" name="answer" maxlength="1020" rows="7" required>{% if answer is not null %}{{ answer }}{% endif %}</textarea>
			</label>
			<div class="faq-editor__actions">
				<button class="zealot-button" type="submit">Save FAQ</button>
			</div>
		</div>
	</section>
</form>
